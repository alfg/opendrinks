        },
        {
            "quantity": "5",
            "measure": "cubes",
            "ingredient": "ice"
        }
    ],
    "directions": [
        "Blend the chopped mangoes. Keep a few pieces aside for topping the drink.",
        "into a glass add the prepared mango puree",
        "add tender coconut water into the same glass",
        "add few ice cubes",
        "add soaked chia seeds","top with fresh mango pieces",
        "mix everything well and enjoy!!!"
